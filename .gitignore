/target

# Local agent/editor state and machine-specific notes, kept out of the repo.
/.claude/
/CLAUDE.md
/win11-vm-handoff.md
/.vscode/
/.idea/

# Runtime data -- never belongs in the repo.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
tokens.json
preferences.json

# Local config. config.example.toml is the tracked reference.
/config.toml

# Export output lands in the working directory by default.
*.m3u8
*.csv
!config.example.toml

# Build/verification scratch
/dist/
*.tar.gz
*.zip
